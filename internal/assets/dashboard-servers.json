{"uid": "webscan-servers", "title": "Webscan servers", "schemaVersion": 41, "version": 1, "timezone": "Asia/Shanghai", "refresh": "30s", "time": {"from": "now-1h", "to": "now"}, "panels": [{"id": 1, "title": "节点在线（无数据=未知）", "type": "stat", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "up{job=~\"webscan-node-.*|webscan-central-host\"} or on(node_id) (webscan_node_registered * -1)", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联", "thresholds": {"mode": "absolute", "steps": [{"color": "gray", "value": null}, {"color": "red", "value": 0}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"-1": {"text": "未知/尚未上线", "color": "gray"}, "0": {"text": "失联/异常", "color": "red"}, "1": {"text": "正常", "color": "green"}}}]}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 2, "title": "CPU %", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "100*(1-avg by(node_id)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 3, "title": "内存 %", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "100*(1-node_memory_MemAvailable_bytes/node_memory_MemTotal_bytes)", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 4, "title": "磁盘 %", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "100*(1-node_filesystem_avail_bytes/node_filesystem_size_bytes)", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 5, "title": "负载", "type": "timeseries", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "node_load1", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 6, "title": "网络接收", "type": "timeseries", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "rate(node_network_receive_bytes_total[5m])", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}, {"id": 7, "title": "inode %", "type": "timeseries", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "webscan-prom"}, "targets": [{"expr": "100*(1-node_filesystem_files_free/node_filesystem_files)", "instant": false, "refId": "A"}], "fieldConfig": {"defaults": {"noValue": "未知/失联"}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["last"], "values": false}, "colorMode": "value", "graphMode": "none"}}], "templating": {"list": [{"name": "node", "type": "textbox", "current": {"text": ".*", "value": ".*"}}, {"name": "search", "type": "textbox", "current": {"text": "", "value": ""}}]}}